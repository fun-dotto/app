platform :android do
  # 各フレーバー(dev/stg/prd)の Firebase App ID を保持する環境変数名
  ANDROID_OTA_FIREBASE_APP_ID_ENVS = {
    "dev" => "FIREBASE_APP_ID_ANDROID_DEV",
    "stg" => "FIREBASE_APP_ID_ANDROID_STG",
    "prd" => "FIREBASE_APP_ID_ANDROID_PRD",
  }

  def android_ota_firebase_app_id(flavor)
    ENV[ANDROID_OTA_FIREBASE_APP_ID_ENVS.fetch(flavor)]
  end

  # 指定フレーバーの AAB をビルドする
  # Firebase App Distribution で AAB を配信するには、Firebase アプリと Google Play アプリの連携が必要
  def prepare_android_ota_flavor(flavor)
    flutter_build('appbundle', flavor: flavor)
  end

  def distribute_android_ota_flavor(flavor)
    firebase_app_distribution(
      app: android_ota_firebase_app_id(flavor),
      android_artifact_type: "AAB",
      android_artifact_path: "apps/dotto/build/app/outputs/bundle/#{flavor}Release/app-#{flavor}-release.aab",
      groups: ENV["FIREBASE_APP_DISTRIBUTION_GROUPS"],
      release_notes: ota_release_notes,
    )
  end

  desc "Build OTA (single flavor)"
  lane :build_ota_flavor do |options|
    pre_build
    prepare_android_ota_flavor(options.fetch(:flavor))
  end

  desc "Distribute OTA (single flavor)"
  lane :distribute_ota_flavor do |options|
    flavor = options.fetch(:flavor)
    release = distribute_android_ota_flavor(flavor)
    append_ota_result(platform_label: "Android", flavor: flavor, release: release)
  end

  desc "Deploy OTA (single flavor)"
  lane :deploy_ota_flavor do |options|
    build_ota_flavor(options)
    distribute_ota_flavor(options)
  end

  desc "Deploy OTA (dev, stg, prd)"
  lane :deploy_ota do
    pre_build

    payload = ANDROID_OTA_FIREBASE_APP_ID_ENVS.keys.to_h do |flavor|
      prepare_android_ota_flavor(flavor)
      release = distribute_android_ota_flavor(flavor)
      [
        "Android (#{flavor})",
        "[#{release[:displayVersion]} (#{release[:buildVersion]})](#{release[:testingUri]})",
      ]
    end
    slack(
      message: "Dotto OTA (dev, stg, prd) deployed!",
      payload: payload,
      default_payloads: [:git_branch, :git_author, :last_git_commit, :last_git_commit_hash],
      slack_url: ENV["SLACK_URL"],
    )
  end

  ANDROID_PRODUCTION_FLAVOR = "store"
  ANDROID_PRODUCTION_AAB_PATH = "apps/dotto/build/app/outputs/bundle/#{ANDROID_PRODUCTION_FLAVOR}Release/app-#{ANDROID_PRODUCTION_FLAVOR}-release.aab"

  # Google Play 向けの AAB をビルドする
  # flavor を省略すると Gradle が全 flavor をビルドし、成果物が
  # bundle/<flavor>Release/ 配下に出るため flutter が AAB を見つけられない
  def prepare_android_production
    flutter_build('appbundle', flavor: ANDROID_PRODUCTION_FLAVOR, dart_define: 'prd')
  end

  desc "Build Production"
  lane :build_production do
    pre_build
    prepare_android_production
  end

  # json_key を渡さないことで supply は ADC (GOOGLE_APPLICATION_CREDENTIALS) を利用する。
  # CI では Workload Identity 連携の認証情報が入るため、サービスアカウント鍵は不要
  desc "Upload to Google Play"
  lane :upload_google_play do
    upload_to_play_store(
      aab: ANDROID_PRODUCTION_AAB_PATH,
      release_status: "draft",
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end

  desc "Deploy a new version to the Google Play"
  lane :deploy_google_play do
    build_production
    upload_google_play
  end
end
