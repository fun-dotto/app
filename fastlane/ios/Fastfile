platform :ios do
  IOS_APP_IDENTIFIERS = [
    'jp.ac.fun.dotto.dev',
    'jp.ac.fun.dotto.stg',
    'jp.ac.fun.dotto.prd',
    'jp.ac.fun.dotto',
  ]
  IOS_XCODEPROJ = "apps/dotto/ios/Runner.xcodeproj"
  IOS_WORKSPACE = "apps/dotto/ios/Runner.xcworkspace"

  def get_app_store_connect_api_key
    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT_BASE64"],
      is_key_content_base64: true,
    )
  end

  # 証明書・プロビジョニングプロファイルを作成/更新する
  def match_certificates(type)
    match(
      type: type,
      force_for_new_devices: true,
      api_key: get_app_store_connect_api_key,
      app_identifier: IOS_APP_IDENTIFIERS,
    )
  end

  # 証明書・プロビジョニングプロファイルを読み取り専用で取得する
  def match_certificates_readonly(type)
    setup_ci if ENV['CI']
    match(
      type: type,
      force_for_new_devices: true,
      readonly: true,
      app_identifier: IOS_APP_IDENTIFIERS,
    )
  end

  desc "Match Development"
  lane :match_development do
    match_certificates("development")
  end

  desc "Match Ad Hoc"
  lane :match_adhoc do
    match_certificates("adhoc")
  end

  desc "Match App Store"
  lane :match_appstore do
    match_certificates("appstore")
  end

  desc "Fetch Development"
  lane :match_development_readonly do
    match_certificates_readonly("development")
  end

  desc "Fetch Ad Hoc"
  lane :match_adhoc_readonly do
    match_certificates_readonly("adhoc")
  end

  desc "Fetch App Store"
  lane :match_appstore_readonly do
    match_certificates_readonly("appstore")
  end

  # match の種類ごとの、プロビジョニングプロファイル名の接頭辞と証明書の保存先ディレクトリ
  MATCH_RENEWAL_TYPES = {
    "development" => { profile_prefix: "match Development", cert_dir: "development" },
    "adhoc" => { profile_prefix: "match AdHoc", cert_dir: "distribution" },
    "appstore" => { profile_prefix: "match AppStore", cert_dir: "distribution" },
  }

  # match が管理するプロファイルを App Store Connect API で調べ、
  # 期限切れ間近 (または存在しない・無効) なものと、その署名証明書のうち期限切れ間近なものを返す
  # force が true のときは有効期限に関係なくすべてを対象にする
  def find_expiring_match_assets(days, force: false)
    threshold = Time.now + days * 24 * 60 * 60
    expiring_types = []
    expiring_certs = {} # cert_dir => [certificate id, ...]

    MATCH_RENEWAL_TYPES.each do |type, config|
      IOS_APP_IDENTIFIERS.each do |app_identifier|
        name = "#{config[:profile_prefix]} #{app_identifier}"
        profile = Spaceship::ConnectAPI::Profile.all(
          filter: { name: name },
          includes: "certificates",
        ).find { |p| p.name == name }

        if profile.nil?
          UI.important("#{name}: プロファイルが見つかりません")
          expiring_types << type
          next
        end

        expires_at = Time.parse(profile.expiration_date)
        UI.message("#{name}: #{profile.profile_state} / 有効期限 #{expires_at}")
        next if !force && profile.profile_state == "ACTIVE" && expires_at > threshold

        expiring_types << type
        (profile.certificates || []).each do |cert|
          next if !force && Time.parse(cert.expiration_date) > threshold

          UI.important("証明書 #{cert.id} (#{cert.name}, 有効期限 #{cert.expiration_date}) を更新します")
          (expiring_certs[config[:cert_dir]] ||= []) << cert.id
        end
      end
    end

    [expiring_types.uniq, expiring_certs.transform_values(&:uniq)]
  end

  # 期限切れ間近の証明書を match のリポジトリから取り除く。
  # 次の match 実行時に新しい証明書が作られる。Developer Portal 上の証明書は失効させない
  # (失効させると配布済みの Ad Hoc ビルドが起動できなくなるため、期限切れまでそのまま残す)。
  def remove_certificates_from_match_storage(cert_dir, cert_ids)
    require 'match'
    params = FastlaneCore::Configuration.create(Match::Options.available_options, {
      type: cert_dir == "development" ? "development" : "appstore",
      readonly: false,
      app_identifier: IOS_APP_IDENTIFIERS,
    })
    params.load_configuration_file("Matchfile")
    storage = Match::Storage.from_params(params)
    storage.download

    files = cert_ids.flat_map do |id|
      %w[cer p12].map { |ext| File.join(storage.working_directory, "certs", cert_dir, "#{id}.#{ext}") }
    end.select { |path| File.exist?(path) }

    if files.empty?
      UI.important("certs/#{cert_dir} に削除対象の証明書がありません (#{cert_ids.join(', ')})")
      return
    end

    files.each { |path| FileUtils.rm_f(path) }
    storage.save_changes!(
      files_to_delete: files,
      custom_message: "[fastlane] Remove expiring #{cert_dir} certificates: #{cert_ids.join(', ')}",
    )
  ensure
    storage&.clear_changes
  end

  desc "期限切れ間近の証明書・プロビジョニングプロファイルを更新する"
  desc "  days: 何日前から更新するか (既定 7)"
  desc "  force: true のとき有効期限に関係なく証明書・プロファイルをすべて作り直す"
  lane :renew_certificates do |options|
    days = (options[:days] || 7).to_i
    force = options[:force].to_s == "true"

    setup_ci if ENV['CI']
    get_app_store_connect_api_key

    expiring_types, expiring_certs = find_expiring_match_assets(days, force: force)

    # 証明書を作り直す場合、それで署名する全種類のプロファイルも作り直す
    expiring_certs.each_key do |cert_dir|
      expiring_types |= MATCH_RENEWAL_TYPES.select { |_, c| c[:cert_dir] == cert_dir }.keys
    end

    if expiring_types.empty?
      UI.success("#{days} 日以内に期限切れになる証明書・プロファイルはありません")
      next
    end

    expiring_certs.each do |cert_dir, cert_ids|
      remove_certificates_from_match_storage(cert_dir, cert_ids)
    end

    expiring_types.each do |type|
      match(
        type: type,
        force: true,
        api_key: get_app_store_connect_api_key,
        app_identifier: IOS_APP_IDENTIFIERS,
      )
    end

    summary = "証明書: #{expiring_certs.empty? ? 'なし' : expiring_certs.keys.join(', ')} / プロファイル: #{expiring_types.join(', ')}"
    UI.success("更新しました (#{summary})")
    if ENV["SLACK_URL"].to_s != ""
      slack(
        message: "Dotto iOS の証明書・プロビジョニングプロファイルを更新しました",
        payload: { "更新内容" => summary },
        default_payloads: [],
        slack_url: ENV["SLACK_URL"],
      )
    end
  end

  desc "Register devices"
  lane :register_new_devices do
    register_devices(
      devices_file: "fastlane/ios/devices.txt",
      api_key: get_app_store_connect_api_key,
    )
    match_development
    match_adhoc
  end

  desc "Reset build number"
  lane :reset_build_number do
    increment_build_number(build_number: 1, xcodeproj: IOS_XCODEPROJ)
  end

  # 各フレーバー(dev/stg/prd)の設定
  IOS_OTA_FLAVORS = {
    "dev" => {
      app_identifier: "jp.ac.fun.dotto.dev",
      firebase_app_id_env: "FIREBASE_APP_ID_IOS_DEV",
    },
    "stg" => {
      app_identifier: "jp.ac.fun.dotto.stg",
      firebase_app_id_env: "FIREBASE_APP_ID_IOS_STG",
    },
    "prd" => {
      app_identifier: "jp.ac.fun.dotto.prd",
      firebase_app_id_env: "FIREBASE_APP_ID_IOS_PRD",
    },
  }

  def ios_ota_firebase_app_id(flavor)
    ENV[IOS_OTA_FLAVORS.fetch(flavor)[:firebase_app_id_env]]
  end

  # 直前の build_app で生成された dSYM を Crashlytics へアップロードする
  # SPM 構成のため upload-symbols は DerivedData 内の firebase-ios-sdk チェックアウトから探す
  def upload_dsym_to_crashlytics(firebase_dir)
    binary_path = Dir.glob(File.expand_path("~/Library/Developer/Xcode/DerivedData/Runner-*/SourcePackages/checkouts/firebase-ios-sdk/Crashlytics/upload-symbols")).first
    UI.user_error!("Crashlytics の upload-symbols が見つかりません") if binary_path.nil?

    upload_symbols_to_crashlytics(
      dsym_path: lane_context[SharedValues::DSYM_OUTPUT_PATH],
      gsp_path: "apps/dotto/ios/firebase/#{firebase_dir}/GoogleService-Info.plist",
      binary_path: binary_path,
    )
  end

  # Flutter 側は Xcode のビルド設定だけを生成し (--config-only)、アーカイブは build_app に任せる。
  # flutter build ipa と build_app で 2 回ビルドしていた無駄を省く。
  def build_ios_ipa(flavor:, dart_define:, output_name:, export_method:, provisioning_profiles:, firebase_dir:)
    flutter_build('ios', flavor: flavor, dart_define: dart_define, extra_args: ['--config-only'])
    build_app(
      workspace: IOS_WORKSPACE,
      scheme: flavor,
      configuration: "Release-#{flavor}",
      clean: true,
      output_directory: "build",
      output_name: output_name,
      export_method: export_method,
      export_options: {
        provisioningProfiles: provisioning_profiles,
      },
    )
    upload_dsym_to_crashlytics(firebase_dir)
  end

  # Info.plist の CFBundleVersion は固定値のため、pubspec.yaml のビルド番号を agvtool で反映する
  def apply_pubspec_build_number
    increment_build_number(build_number: pubspec_build_number, xcodeproj: IOS_XCODEPROJ)
  end

  # 指定フレーバーの IPA をビルドする
  def prepare_ios_ota_flavor(flavor)
    apply_pubspec_build_number

    app_identifier = IOS_OTA_FLAVORS.fetch(flavor)[:app_identifier]
    build_ios_ipa(
      flavor: flavor,
      dart_define: flavor,
      output_name: "dotto-#{flavor}.ipa",
      export_method: "ad-hoc",
      provisioning_profiles: { app_identifier => "match AdHoc #{app_identifier}" },
      firebase_dir: flavor,
    )
  end

  def distribute_ios_ota_flavor(flavor)
    firebase_app_distribution(
      app: ios_ota_firebase_app_id(flavor),
      ipa_path: "build/dotto-#{flavor}.ipa",
      groups: ENV["FIREBASE_APP_DISTRIBUTION_GROUPS"],
      release_notes: ota_release_notes,
    )
  end

  desc "Build OTA (single flavor)"
  lane :build_ota_flavor do |options|
    match_development_readonly
    match_adhoc_readonly
    pre_build
    prepare_ios_ota_flavor(options.fetch(:flavor))
  end

  desc "Distribute OTA (single flavor)"
  lane :distribute_ota_flavor do |options|
    flavor = options.fetch(:flavor)
    release = distribute_ios_ota_flavor(flavor)
    append_ota_result(platform_label: "iOS", flavor: flavor, release: release)
  end

  desc "Deploy OTA (single flavor)"
  lane :deploy_ota_flavor do |options|
    build_ota_flavor(options)
    distribute_ota_flavor(options)
    reset_build_number
  end

  desc "Deploy OTA (dev, stg, prd)"
  lane :deploy_ota do
    match_development_readonly
    match_adhoc_readonly
    pre_build

    payload = IOS_OTA_FLAVORS.keys.to_h do |flavor|
      prepare_ios_ota_flavor(flavor)
      release = distribute_ios_ota_flavor(flavor)
      reset_build_number
      [
        "iOS (#{flavor})",
        "[#{release[:displayVersion]} (#{release[:buildVersion]})](#{release[:testingUri]})",
      ]
    end
    slack(
      message: "Dotto OTA (dev, stg, prd) deployed!",
      payload: payload,
      default_payloads: [:git_branch, :git_author, :last_git_commit, :last_git_commit_hash],
      slack_url: ENV["SLACK_URL"],
    )
  end

  IOS_PRODUCTION_FLAVOR = "store"
  IOS_PRODUCTION_IPA_PATH = "build/dotto.ipa"

  # App Store 向けの IPA をビルドする
  def prepare_ios_production
    apply_pubspec_build_number
    build_ios_ipa(
      flavor: IOS_PRODUCTION_FLAVOR,
      dart_define: "prd",
      output_name: File.basename(IOS_PRODUCTION_IPA_PATH),
      export_method: "app-store",
      provisioning_profiles: { "jp.ac.fun.dotto" => "match AppStore jp.ac.fun.dotto" },
      firebase_dir: "default",
    )
  end

  desc "Build Production"
  lane :build_production do
    match_appstore_readonly
    pre_build
    prepare_ios_production
  end

  desc "Upload to TestFlight"
  lane :upload_testflight do
    upload_to_testflight(
      api_key: get_app_store_connect_api_key,
      ipa: IOS_PRODUCTION_IPA_PATH,
      skip_submission: true,
      notify_external_testers: true,
      skip_waiting_for_build_processing: true,
      # distribute_external: true,
      # groups: ["Dotto Developer"],
      # changelog: "",
    )
  end

  desc "Deploy to TestFlight"
  lane :deploy_to_testflight do
    build_production
    upload_testflight
    reset_build_number
  end
end
