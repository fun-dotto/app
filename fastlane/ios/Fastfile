platform :ios do
  ENV["FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT"] = "30"

  def get_app_store_connect_api_key
    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_API_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_API_KEY_CONTENT_BASE64"],
      is_key_content_base64: true,
    )
  end

  desc "Match Development"
  lane :match_development do
    match(
      type: "development",
      force_for_new_devices: true,
      api_key: get_app_store_connect_api_key,
      app_identifier: [
        'jp.ac.fun.dotto.dev',
        'jp.ac.fun.dotto.stg',
        'jp.ac.fun.dotto.prd',
        'jp.ac.fun.dotto',
      ]
    )
  end

  desc "Match Ad Hoc"
  lane :match_adhoc do
    match(
      type: "adhoc",
      force_for_new_devices: true,
      api_key: get_app_store_connect_api_key,
      app_identifier: [
        'jp.ac.fun.dotto.dev',
        'jp.ac.fun.dotto.stg',
        'jp.ac.fun.dotto.prd',
        'jp.ac.fun.dotto',
      ]
    )
  end

  desc "Match App Store"
  lane :match_appstore do
    match(
      type: "appstore",
      force_for_new_devices: true,
      api_key: get_app_store_connect_api_key,
      app_identifier: [
        'jp.ac.fun.dotto.dev',
        'jp.ac.fun.dotto.stg',
        'jp.ac.fun.dotto.prd',
        'jp.ac.fun.dotto',
      ]
    )
  end

  desc "Fetch Development"
  lane :match_development_readonly do
    setup_ci if ENV['CI']
    match(
      type: "development",
      force_for_new_devices: true,
      readonly: true,
      app_identifier: [
        'jp.ac.fun.dotto.dev',
        'jp.ac.fun.dotto.stg',
        'jp.ac.fun.dotto.prd',
        'jp.ac.fun.dotto',
      ]
    )
  end

  desc "Fetch Ad Hoc"
  lane :match_adhoc_readonly do
    setup_ci if ENV['CI']
    match(
      type: "adhoc",
      force_for_new_devices: true,
      readonly: true,
      app_identifier: [
        'jp.ac.fun.dotto.dev',
        'jp.ac.fun.dotto.stg',
        'jp.ac.fun.dotto.prd',
        'jp.ac.fun.dotto',
      ]
    )
  end

  desc "Fetch App Store"
  lane :match_appstore_readonly do
    setup_ci if ENV['CI']
    match(
      type: "appstore",
      force_for_new_devices: true,
      readonly: true,
      app_identifier: [
        'jp.ac.fun.dotto.dev',
        'jp.ac.fun.dotto.stg',
        'jp.ac.fun.dotto.prd',
        'jp.ac.fun.dotto',
      ]
    )
  end

  desc "Register devices"
  lane :register_new_devices do
    register_devices(
      devices_file: "fastlane/ios/devices.txt",
      api_key: get_app_store_connect_api_key,
    )
    match_development
    match_adhoc
  end

  desc "Reset build number"
  lane :reset_build_number do
    increment_build_number({
      build_number: 1,
      xcodeproj: "apps/dotto/ios/Runner.xcodeproj",
    })
  end

  desc "Pre-build"
  lane :pre_build do
    sh('melos', 'bootstrap')
    sh('melos', 'run', 'gen:build_runner', '--no-select')
  end

  # 各フレーバー(dev/stg/prd)の設定
  OTA_FLAVORS = {
    "dev" => {
      app_identifier: "jp.ac.fun.dotto.dev",
      firebase_app_id_env: "FIREBASE_APP_ID_IOS_DEV",
    },
    "stg" => {
      app_identifier: "jp.ac.fun.dotto.stg",
      firebase_app_id_env: "FIREBASE_APP_ID_IOS_STG",
    },
    "prd" => {
      app_identifier: "jp.ac.fun.dotto.prd",
      firebase_app_id_env: "FIREBASE_APP_ID_IOS_PRD",
    },
  }

  desc "Build OTA (per flavor)"
  def build_ota_flavor(flavor)
    config = OTA_FLAVORS.fetch(flavor)
    app_identifier = config[:app_identifier]
    sh(
      'melos',
      'exec',
      '--scope=dotto',
      '--',
      'flutter',
      'build',
      'ipa',
      '--release',
      "--flavor=#{flavor}",
      "--dart-define-from-file=dart_defines/#{flavor}.json",
    )
    build_app(
      workspace: "apps/dotto/ios/Runner.xcworkspace",
      scheme: flavor,
      configuration: "Release-#{flavor}",
      clean: true,
      output_directory: "build",
      output_name: "dotto-#{flavor}.ipa",
      export_method: "ad-hoc",
      export_options: {
        provisioningProfiles: {
          app_identifier => "match AdHoc #{app_identifier}",
        },
      },
    )
  end

  # 指定フレーバーをビルドしてFirebase App Distributionに配信し、リリース情報を返す
  def distribute_ota_flavor(flavor)
    config = OTA_FLAVORS.fetch(flavor)
    firebase_app_id = ENV[config[:firebase_app_id_env]]

    latest_release = firebase_app_distribution_get_latest_release(
      app: firebase_app_id,
    )
    if latest_release.nil?
      reset_build_number
    else
      increment_build_number(
        build_number: latest_release[:buildVersion].to_i + 1,
        xcodeproj: "apps/dotto/ios/Runner.xcodeproj",
      )
    end

    build_ota_flavor(flavor)

    release = firebase_app_distribution(
      app: firebase_app_id,
      groups: ENV["FIREBASE_APP_DISTRIBUTION_GROUPS"],
    )
    reset_build_number
    release
  end

  desc "Deploy OTA (dev, stg, prd)"
  lane :deploy_ota do
    match_adhoc_readonly
    pre_build

    releases = OTA_FLAVORS.keys.map do |flavor|
      [flavor, distribute_ota_flavor(flavor)]
    end

    payload = releases.to_h do |flavor, release|
      [
        "iOS (#{flavor})",
        "[#{release[:displayVersion]} (#{release[:buildVersion]})](#{release[:testingUri]})",
      ]
    end
    slack(
      message: "Dotto OTA (dev, stg, prd) deployed!",
      payload: payload,
      default_payloads: [:git_branch, :git_author, :last_git_commit, :last_git_commit_hash],
      slack_url: ENV["SLACK_URL"],
    )
  end

  desc "Build Production"
  lane :build_production do
    match_appstore_readonly
    pre_build
    flutter_release_build
    build_app(
      workspace: "apps/dotto/ios/Runner.xcworkspace",
      scheme: "Runner",
      configuration: "Release",
      clean: true,
      output_directory: "build",
      output_name: "dotto.ipa",
      export_method: "app-store",
      export_options: {
        clean: true,
        provisioningProfiles: {
          "jp.ac.fun.dotto" => "match AppStore jp.ac.fun.dotto",
        },
      },
    )
  end

  desc "Deploy to TestFlight"
  lane :deploy_to_testflight do
    increment_build_number({
      build_number: latest_testflight_build_number + 1
    })
    build_production
    upload_to_testflight(
      skip_submission: true,
      notify_external_testers: true,
      skip_waiting_for_build_processing: true,
      # distribute_external: true,
      # groups: ["Dotto Developer"],
      # changelog: "",
    )
    reset_build_number
  end
end
