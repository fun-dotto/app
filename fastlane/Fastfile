require 'fileutils'

import('android/Fastfile')
import('ios/Fastfile')

# OTA配信1件分のリリース情報を OTA_RESULT_FILE で指定されたファイルへ書き出す共通ヘルパー。
# GitHub Actions のマトリクスジョブが成果物としてアップロードし、最後にまとめて Slack 通知するために利用する。
def append_ota_result(platform_label:, flavor:, release:)
  result_file = ENV["OTA_RESULT_FILE"]
  return if result_file.nil? || result_file.empty?

  result_file = File.expand_path(result_file)
  FileUtils.mkdir_p(File.dirname(result_file))
  line = [
    "#{platform_label} (#{flavor})",
    "#{release[:displayVersion]} (#{release[:buildVersion]})",
    release[:testingUri],
  ].join("\t")
  File.write(result_file, "#{line}\n")
  UI.message("Wrote OTA result to #{result_file}")
end

# OTA配信のリリースノート(コミットハッシュ + コミットメッセージ)を組み立てる共通ヘルパー。
# Firebase App Distribution の release_notes に渡し、どのコミットのビルドかをテスターが確認できるようにする。
def ota_release_notes
  commit_hash = sh("git", "rev-parse", "--short", "HEAD", log: false).strip
  commit_message = sh("git", "log", "-1", "--pretty=%B", log: false).strip
  "#{commit_hash}: #{commit_message}"
end

# 外部サービス(Gradle Plugin Portal / Maven リポジトリ、Firebase App Distribution API など)の
# 一時的な障害で CI が落ちないよう、ブロックを一定回数までリトライする共通ヘルパー。
# 恒久的なエラーでも最大 attempts 回は実行されるため、冪等な処理にのみ使う。
def with_retry(label:, attempts: 3, wait_seconds: 30)
  attempt = 1
  begin
    yield
  rescue StandardError => e
    raise if attempt >= attempts

    UI.important("#{label} failed (attempt #{attempt}/#{attempts}): #{e.class}: #{e.message.lines.first&.strip}")
    UI.important("Retrying in #{wait_seconds * attempt}s...")
    sleep(wait_seconds * attempt)
    attempt += 1
    retry
  end
end
