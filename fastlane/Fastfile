require 'fileutils'
require 'shellwords'

ENV["FASTLANE_XCODEBUILD_SETTINGS_TIMEOUT"] = "30"

import('android/Fastfile')
import('ios/Fastfile')

# OTA配信1件分のリリース情報を OTA_RESULT_FILE で指定されたファイルへ書き出す共通ヘルパー。
# GitHub Actions のマトリクスジョブが成果物としてアップロードし、最後にまとめて Slack 通知するために利用する。
def append_ota_result(platform_label:, flavor:, release:)
  result_file = ENV["OTA_RESULT_FILE"]
  return if result_file.nil? || result_file.empty?

  result_file = File.expand_path(result_file)
  FileUtils.mkdir_p(File.dirname(result_file))
  line = [
    "#{platform_label} (#{flavor})",
    "#{release[:displayVersion]} (#{release[:buildVersion]})",
    release[:testingUri],
  ].join("\t")
  File.write(result_file, "#{line}\n")
  UI.message("Wrote OTA result to #{result_file}")
end

# OTA配信のリリースノート(コミットハッシュ + コミットメッセージ)を組み立てる共通ヘルパー。
# Firebase App Distribution の release_notes に渡し、どのコミットのビルドかをテスターが確認できるようにする。
def ota_release_notes
  commit_hash = sh("git", "rev-parse", "--short", "HEAD", log: false).strip
  commit_message = sh("git", "log", "-1", "--pretty=%B", log: false).strip
  "#{commit_hash}: #{commit_message}"
end

desc "Pre-build"
lane :pre_build do
  # melos はワークスペースの dev_dependency なので、pub get 後に dart run で呼び出す。
  # `melos run` は内部で `melos exec` をシェル経由で起動するため、melos バイナリが
  # PATH に無い環境 (CI) では失敗する。`melos exec` を直接呼んで回避する。
  sh('flutter', 'pub', 'get')
  sh('dart', 'run', 'melos', 'exec', '--depends-on', 'build_runner', '--concurrency', '8', '--', 'dart run build_runner build --delete-conflicting-outputs')
end

# apps/dotto で flutter build を実行する共通ヘルパー。
# store flavor は prd と同じ本番バックエンドを参照するため dart_define に prd を渡す。
def flutter_build(target, flavor:, dart_define: flavor, build_number: nil, extra_args: [])
  args = [
    'flutter', 'build', target, '--release',
    "--flavor=#{flavor}",
    "--dart-define-from-file=dart_defines/#{dart_define}.json",
  ]
  args << "--build-number=#{build_number}" unless build_number.nil?
  args.concat(extra_args)
  sh("cd apps/dotto && #{Shellwords.join(args)}")
end
