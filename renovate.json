{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "minimumReleaseAge": "24 hours",
  "separateMajorMinor": false,
  "automerge": true,
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Wait for workspace dependency resolution before opening Dart dependency PRs",
      "matchManagers": ["pub"],
      "prCreation": "status-success",
      "internalChecksAsSuccess": false
    },
    {
      "groupName": "firebase",
      "matchManagers": ["pub"],
      "matchPackageNames": [
        "firebase_core",
        "firebase_auth",
        "firebase_analytics",
        "firebase_crashlytics",
        "firebase_database",
        "firebase_messaging",
        "firebase_remote_config",
        "firebase_storage",
        "firebase_app_check",
        "cloud_firestore",
        "firebase_auth_platform_interface",
        "firebase_core_platform_interface"
      ]
    },
    {
      "groupName": "plus plugins",
      "matchManagers": ["pub"],
      "matchPackageNames": [
        "package_info_plus",
        "share_plus"
      ]
    },
    {
      "groupName": "sqflite",
      "matchManagers": ["pub"],
      "matchPackageNames": [
        "sqflite",
        "sqflite_common"
      ]
    },
    {
      "groupName": "dart analyzer toolchain",
      "matchManagers": ["pub"],
      "matchPackageNames": [
        "build_runner",
        "flutter_riverpod",
        "freezed",
        "freezed_annotation",
        "go_router_builder",
        "hooks_riverpod",
        "json_annotation",
        "json_serializable",
        "mockito",
        "riverpod_annotation",
        "riverpod_generator",
        "widgetbook",
        "widgetbook_annotation",
        "widgetbook_generator"
      ]
    }
  ]
}
