{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": ["pub"],
  "extends": [
    "config:best-practices",
    ":pinVersions",
    ":timezone(Asia/Tokyo)"
  ],
  "schedule": [
    "before 4:00am on Monday",
    "before 4:00am on Wednesday",
    "before 4:00am on Friday"
  ],
  "major": {
    "minimumReleaseAge": "14 days"
  },
  "minor": {
    "minimumReleaseAge": "7 days"
  },
  "patch": {
    "minimumReleaseAge": "7 days"
  },
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": [
      "before 4:00am on Monday",
      "before 4:00am on Wednesday",
      "before 4:00am on Friday"
    ]
  },
  "packageRules": [
    {
      "description": "Update pubspec.lock together with Pub dependency updates",
      "matchManagers": [
        "pub"
      ],
      "skipArtifactsUpdate": false
    },
    {
      "matchManagers": [
        "mise"
      ],
      "matchPackageNames": [
        "flutter",
        "ruby"
      ],
      "matchUpdateTypes": [
        "minor",
        "major"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "mise"
      ],
      "matchPackageNames": [
        "flutter",
        "ruby"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "schedule": [
        "before 4:00am on Monday",
        "before 4:00am on Wednesday",
        "before 4:00am on Friday"
      ]
    },
    {
      "matchManagers": [
        "mise"
      ],
      "matchPackageNames": [
        "java"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "mise"
      ],
      "matchPackageNames": [
        "java"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "schedule": [
        "before 4:00am on Monday",
        "before 4:00am on Wednesday",
        "before 4:00am on Friday"
      ]
    },
    {
      "groupName": "firebase",
      "matchManagers": [
        "pub"
      ],
      "matchPackageNames": [
        "firebase_core",
        "firebase_auth",
        "firebase_analytics",
        "firebase_crashlytics",
        "firebase_database",
        "firebase_messaging",
        "firebase_remote_config",
        "firebase_storage",
        "firebase_app_check",
        "cloud_firestore",
        "firebase_auth_platform_interface",
        "firebase_core_platform_interface"
      ]
    },
    {
      "description": "win32 / geolocator_linux の制約で lockstep 更新が必要なため、メジャーも含めて1つのPRにまとめる",
      "groupName": "plus plugins",
      "matchManagers": [
        "pub"
      ],
      "matchPackageNames": [
        "geolocator",
        "package_info_plus",
        "share_plus"
      ],
      "separateMajorMinor": false
    },
    {
      "groupName": "riverpod",
      "matchManagers": [
        "pub"
      ],
      "matchPackageNames": [
        "flutter_riverpod",
        "hooks_riverpod",
        "riverpod_annotation",
        "riverpod_generator"
      ]
    },
    {
      "groupName": "freezed",
      "matchManagers": [
        "pub"
      ],
      "matchPackageNames": [
        "freezed",
        "freezed_annotation"
      ]
    },
    {
      "groupName": "json serialization",
      "matchManagers": [
        "pub"
      ],
      "matchPackageNames": [
        "json_annotation",
        "json_serializable"
      ]
    },
    {
      "groupName": "go router",
      "matchManagers": [
        "pub"
      ],
      "matchPackageNames": [
        "go_router",
        "go_router_builder"
      ]
    },
    {
      "groupName": "one of",
      "matchManagers": [
        "pub"
      ],
      "matchPackageNames": [
        "one_of",
        "one_of_serializer"
      ]
    },
    {
      "groupName": "widgetbook",
      "matchManagers": [
        "pub"
      ],
      "matchPackageNames": [
        "widgetbook",
        "widgetbook_annotation",
        "widgetbook_generator"
      ]
    },
    {
      "groupName": "sqflite",
      "matchManagers": [
        "pub"
      ],
      "matchPackageNames": [
        "sqflite",
        "sqflite_common"
      ]
    },
    {
      "description": "Keep analyzer-constrained Dart dev tools in the same update PR",
      "groupName": "dart analyzer toolchain",
      "matchManagers": [
        "pub"
      ],
      "matchPackageNames": [
        "build_runner",
        "built_value",
        "built_value_generator",
        "freezed",
        "freezed_annotation",
        "flutter_riverpod",
        "go_router_builder",
        "hooks_riverpod",
        "json_annotation",
        "json_serializable",
        "mockito",
        "riverpod_annotation",
        "riverpod_generator",
        "test",
        "widgetbook_annotation",
        "widgetbook_generator"
      ]
    },
    {
      "description": "Keep Melos updates with CLI-related tooling when shared transitive constraints move together",
      "groupName": "melos toolchain",
      "matchManagers": [
        "pub"
      ],
      "matchPackageNames": [
        "flutter_launcher_icons",
        "melos"
      ]
    },
    {
      "description": "melos >=7.8.2 は cli_util ^0.5.0 を要求し、flutter_launcher_icons (cli_util ^0.4.1) と競合するため保留",
      "matchManagers": [
        "pub"
      ],
      "matchPackageNames": [
        "melos"
      ],
      "allowedVersions": "<7.8.2"
    },
    {
      "description": "built_value(_generator) >=8.12.6 は analyzer ^13 を要求し、riverpod_generator (analyzer ^12) と競合するため保留",
      "matchManagers": [
        "pub"
      ],
      "matchPackageNames": [
        "built_value",
        "built_value_generator"
      ],
      "allowedVersions": "<8.12.6"
    },
    {
      "description": "test >=1.31.2 は analyzer >=13 を要求し、built_value_generator <8.12.6 (analyzer <13) と競合するため保留",
      "matchManagers": [
        "pub"
      ],
      "matchPackageNames": [
        "test"
      ],
      "allowedVersions": "<1.31.2"
    },
    {
      "description": "intl is pinned by flutter_localizations and must wait for a Flutter SDK update",
      "matchManagers": [
        "pub"
      ],
      "matchPackageNames": [
        "intl"
      ],
      "enabled": false
    }
  ]
}
