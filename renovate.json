{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": ["pub"],
  "extends": [
    "config:best-practices",
    ":pinVersions",
    ":timezone(Asia/Tokyo)"
  ],
  "schedule": [
    "before 4:00am on Monday",
    "before 4:00am on Wednesday",
    "before 4:00am on Friday"
  ],
  "major": {
    "minimumReleaseAge": "14 days"
  },
  "minor": {
    "minimumReleaseAge": "7 days"
  },
  "patch": {
    "minimumReleaseAge": "7 days"
  },
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "schedule": [
      "before 4:00am on Monday",
      "before 4:00am on Wednesday",
      "before 4:00am on Friday"
    ]
  },
  "packageRules": [
    {
      "description": "Update pubspec.lock together with Pub dependency updates",
      "matchManagers": [
        "pub"
      ],
      "skipArtifactsUpdate": false
    },
    {
      "matchManagers": [
        "mise"
      ],
      "matchPackageNames": [
        "flutter",
        "ruby"
      ],
      "matchUpdateTypes": [
        "minor",
        "major"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "mise"
      ],
      "matchPackageNames": [
        "flutter",
        "ruby"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "schedule": [
        "before 4:00am on Monday",
        "before 4:00am on Wednesday",
        "before 4:00am on Friday"
      ]
    },
    {
      "matchManagers": [
        "mise"
      ],
      "matchPackageNames": [
        "java"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "mise"
      ],
      "matchPackageNames": [
        "java"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "schedule": [
        "before 4:00am on Monday",
        "before 4:00am on Wednesday",
        "before 4:00am on Friday"
      ]
    },
    {
      "groupName": "firebase",
      "matchManagers": [
        "pub"
      ],
      "matchPackageNames": [
        "firebase_core",
        "firebase_auth",
        "firebase_analytics",
        "firebase_crashlytics",
        "firebase_database",
        "firebase_messaging",
        "firebase_remote_config",
        "firebase_storage",
        "firebase_app_check",
        "cloud_firestore",
        "firebase_auth_platform_interface",
        "firebase_core_platform_interface"
      ]
    },
    {
      "groupName": "plus plugins",
      "matchManagers": [
        "pub"
      ],
      "matchPackageNames": [
        "package_info_plus",
        "share_plus"
      ]
    },
    {
      "groupName": "riverpod",
      "matchManagers": [
        "pub"
      ],
      "matchPackageNames": [
        "flutter_riverpod",
        "hooks_riverpod",
        "riverpod_annotation",
        "riverpod_generator"
      ]
    },
    {
      "groupName": "freezed",
      "matchManagers": [
        "pub"
      ],
      "matchPackageNames": [
        "freezed",
        "freezed_annotation"
      ]
    },
    {
      "groupName": "json serialization",
      "matchManagers": [
        "pub"
      ],
      "matchPackageNames": [
        "json_annotation",
        "json_serializable"
      ]
    },
    {
      "groupName": "go router",
      "matchManagers": [
        "pub"
      ],
      "matchPackageNames": [
        "go_router",
        "go_router_builder"
      ]
    },
    {
      "groupName": "one of",
      "matchManagers": [
        "pub"
      ],
      "matchPackageNames": [
        "one_of",
        "one_of_serializer"
      ]
    },
    {
      "groupName": "widgetbook",
      "matchManagers": [
        "pub"
      ],
      "matchPackageNames": [
        "widgetbook",
        "widgetbook_annotation",
        "widgetbook_generator"
      ]
    },
    {
      "groupName": "sqflite",
      "matchManagers": [
        "pub"
      ],
      "matchPackageNames": [
        "sqflite",
        "sqflite_common"
      ]
    }
  ]
}
