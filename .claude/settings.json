{
  "defaultMode": "default",
  "enabledMcpjsonServers": [
    "context7",
    "dart-mcp-server",
    "dotto-figma",
    "dotto-notion",
    "firebase-mcp-server"
  ],
  "permissions": {
    "allow": [
      "Bash(* --version)",
      "Bash(* --help *)",
      "Bash(cat *)",
      "Bash(echo *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(ls *)",
      "Bash(mise install)",
      "Bash(mise run *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Read(*)",
      "mcp__context7__*",
      "mcp__dart-mcp-server__*",
      "mcp__dotto-figma__*",
      "mcp__dotto-notion__*",
      "mcp__firebase-mcp-server__*"
    ]
  }
}
